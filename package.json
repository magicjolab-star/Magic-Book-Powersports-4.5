{
  "name": "magic-book-powersports-beta",
  "version": "5.1.0",
  "private": true,
  "main": "index.ts",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run typecheck && npm test && expo export --platform web --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist",
    "check:assets": "node scripts/check-assets.mjs",
    "cap:add:android": "cap add android",
    "cap:sync:android": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "@revenuecat/purchases-capacitor": "13.6.0",
    "@revenuecat/purchases-capacitor-ui": "13.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "license": "UNLICENSED"
}
